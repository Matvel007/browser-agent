{
  "manifest_version": 3,
  "name": "Browser Agent",
  "version": "1.0.1",
  "description": "Autonomous AI assistant for Chromium browsers with Chrome DevTools Protocol automation",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Browser Agent"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Открыть Browser Agent"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "assets/*", "locales/*", "icons/logo.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
