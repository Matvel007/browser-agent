{
  "manifest_version": 3,
  "name": "DevTools AI Copilot",
  "version": "1.0.0",
  "description": "ChatGPT-style AI Agent with Chrome DevTools Protocol & Browser Automation",
  "permissions": [
    "sidePanel",
    "debugger",
    "tabs",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open DevTools AI Copilot"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
