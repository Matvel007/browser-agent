{
  "name": "browser-agent",
  "version": "1.0.0",
  "description": "Autonomous AI Agent for Chromium browsers with Chrome DevTools Protocol automation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run typecheck && node ./node_modules/vite/bin/vite.js build",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.tests.json",
    "test": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:e2e": "npm run build && node ./node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.0.308",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" }
}
